{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "local-llm-lab measurement record",
  "description": "One file per measured configuration. Every key is required; a value the lab did not record is null, and notes says what is missing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "stage", "order", "role", "chart", "model", "engine", "parameters",
    "metrics", "hardware", "system", "measured_on", "command", "runs",
    "source", "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "stage": { "type": ["integer", "null"], "minimum": 1 },
    "order": { "type": ["integer", "null"], "minimum": 1 },
    "role": { "type": ["string", "null"] },
    "chart": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["label", "sublabel", "series"],
      "properties": {
        "label": { "type": "string" },
        "sublabel": { "type": "string" },
        "series": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantization", "file", "size_gb", "parameters_b", "active_parameters_b"],
      "properties": {
        "name": { "type": "string" },
        "quantization": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "size_gb": { "type": ["number", "null"], "minimum": 0 },
        "parameters_b": { "type": ["number", "null"], "minimum": 0 },
        "active_parameters_b": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build", "backend"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "backend": { "type": ["string", "null"] }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_layers", "gpu_offload", "context", "kv_cache_type", "flash_attention", "flags"],
      "properties": {
        "gpu_layers": { "type": ["integer", "null"], "minimum": 0 },
        "gpu_offload": { "type": ["string", "null"] },
        "context": { "type": ["integer", "null"], "minimum": 1 },
        "kv_cache_type": { "type": ["string", "null"] },
        "flash_attention": { "type": ["boolean", "null"] },
        "flags": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "unit", "value", "approximate", "statistic", "samples"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["generation_speed", "prompt_processing_speed", "vram", "time_to_first_token"]
          },
          "label": { "type": "string" },
          "unit": { "type": "string", "enum": ["tok/s", "chunks/s", "GB", "s"] },
          "value": { "type": "number", "minimum": 0 },
          "approximate": { "type": "boolean" },
          "statistic": { "type": ["string", "null"], "enum": ["median", "single", null] },
          "samples": { "type": ["array", "null"], "items": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "vram_gb", "ram_gb", "cpu"],
      "properties": {
        "gpu": { "type": ["string", "null"] },
        "vram_gb": { "type": ["number", "null"], "minimum": 0 },
        "ram_gb": { "type": ["number", "null"], "minimum": 0 },
        "cpu": { "type": ["string", "null"] }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "gpu_driver"],
      "properties": {
        "os": { "type": ["string", "null"] },
        "gpu_driver": { "type": ["string", "null"] }
      }
    },
    "measured_on": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "date_kind", "commit"],
      "properties": {
        "date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
        },
        "date_kind": { "type": ["string", "null"], "enum": ["measurement", "commit", null] },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "command": { "type": ["string", "null"] },
    "runs": { "type": ["integer", "null"], "minimum": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "section", "also_in"],
      "properties": {
        "file": { "type": "string" },
        "section": { "type": "string" },
        "also_in": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
